{
  "id": "rotator-cuff-rehab-v1",
  "name": "Rotator Cuff Rehab",
  "description": "Left shoulder rotator cuff rehab program — subscapularis-dominant tendinopathy, supraspinatus involvement, AC joint irritation.",
  "version": "1.0.0",
  "author": "",
  "bodyRegion": "shoulder",
  "condition": "Rotator cuff tendinopathy",

  "categories": [
    { "id": "isometric", "label": "Isometric", "colorClass": "bg-teal/10 text-teal dark:bg-teal/20 dark:text-teal-light" },
    { "id": "isotonic", "label": "Isotonic", "colorClass": "bg-amber/10 text-amber dark:bg-amber/20" },
